# Supabase: URL du projet + clés serveur/client (ne jamais publier la clé secrète)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibilité des anciens projets Supabase seulement (déconseillé):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Secret aléatoire >= 32 caractères (utilisé pour sessions admin et HMAC devis)
ADMIN_SESSION_SECRET=

# YouTube Data API v3 — serveur uniquement
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Bot Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monetbil v2.1
MONETBIL_SERVICE_KEY=
MONETBIL_SECRET_KEY=
MONETBIL_NOTIFY_URL=

# Google Apps Script Web App — token identique aux Script Properties
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
